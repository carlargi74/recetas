# Copia este archivo como ".env" y rellena los valores

# Clave de API de Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini a usar (debe soportar video)
GEMINI_MODEL=gemini-2.5-flash

# Cadena aleatoria larga para firmar las sesiones (genera una con: openssl rand -hex 32)
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga

# Usuario administrador inicial (se crea solo si no existe ningún usuario)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiame
